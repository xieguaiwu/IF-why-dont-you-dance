  <item nodeId="node-71">
    <command xml:space="preserve">x ray</command>
    <result xml:space="preserve">She is such an ugly woman that you can't stand her for one more second.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
